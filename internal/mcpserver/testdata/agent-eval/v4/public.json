{
  "version": "agent-tool-eval.v4",
  "fixture_revision": "mcp-tool-redesign-v1",
  "minimum_trials_per_condition": 3,
  "external_oracle": {
    "version": "agent-tool-eval-oracle.v4",
    "sha256": "6762b0300550de82f88ef16e6a730acaa463a6da48bb200b7e6dde3c0290ae49"
  },
  "controlled_variables": [
    "model",
    "sampling_settings",
    "catalog_fingerprint",
    "corpus_revision",
    "permissions",
    "task_prompt",
    "token_budget"
  ],
  "catalogs": [
    {
      "id": "contribute",
      "toolsets": ["contribute"],
      "disabled_tools": [],
      "sha256": "10daf5747e9cad9a5583b36da28eb3939de086cb69bf7d4c35e886566e82c1d8"
    },
    {
      "id": "contribute_without_issue_set",
      "toolsets": ["contribute"],
      "disabled_tools": ["workflow.prepare_issue_set"],
      "sha256": "f5e9b5e4508c68c09e701f2e7cc70884ec62c13f34cbd119ce2ec90b4026277c"
    },
    {
      "id": "portfolio",
      "toolsets": ["portfolio"],
      "disabled_tools": [],
      "sha256": "75b96382b71699caef1dba684c19ea986cf4f04fbc91b2531c7750cdd5c7c6d5"
    },
    {
      "id": "portfolio_without_composite",
      "toolsets": ["portfolio"],
      "disabled_tools": ["github.sync_portfolio"],
      "sha256": "b9852740bc593efd743a4b9267880391323f633f0a2bea25e235a1885055c822"
    },
    {
      "id": "research",
      "toolsets": ["research"],
      "disabled_tools": [],
      "sha256": "0a3697b4c8d1e5f478f817c856bcc94d235fa9be272a51510b6e32e5857d49d1"
    },
    {
      "id": "concerns",
      "toolsets": ["concerns"],
      "disabled_tools": [],
      "sha256": "a04aa97e612c3502c8a6a8f14bc2e92db6096415b8db2309f85f0069d753ff2f"
    }
  ],
  "scenarios": [
    {
      "id": "stored_vs_live_search",
      "prompt": "Find stored threads about the retry budget in acme/rocket. Do not contact GitHub unless the local snapshot cannot answer; state the coverage limit.",
      "conditions": [
        {"id": "current", "catalog": "contribute"},
        {"id": "live_unavailable", "catalog": "contribute", "permissions": "network_denied"}
      ]
    },
    {
      "id": "exact_issue_set_vs_manual",
      "prompt": "Prepare a bounded contribution brief for stored issues 7, 11, and 14 in acme/rocket, preserving per-issue coverage and failures.",
      "conditions": [
        {"id": "aggregate", "catalog": "contribute"},
        {"id": "manual", "catalog": "contribute_without_issue_set"}
      ]
    },
    {
      "id": "repository_search_modes",
      "prompt": "Search live GitHub repositories using the supplied search request. Use its raw query verbatim when raw_query is present; otherwise use the structured filters. Never combine modes.",
      "conditions": [
        {"id": "raw", "catalog": "contribute", "input_variant": "raw_query"},
        {"id": "structured", "catalog": "contribute", "input_variant": "structured_filters"}
      ]
    },
    {
      "id": "thread_sync_modes",
      "prompt": "Refresh the supplied GitHub thread selection with a bounded header sync. Preserve whether the selection names repositories or exact threads.",
      "conditions": [
        {"id": "repository", "catalog": "contribute", "input_variant": "repositories"},
        {"id": "exact", "catalog": "contribute", "input_variant": "threads"}
      ]
    },
    {
      "id": "draft_modes",
      "prompt": "Prepare the requested contribution draft from the stored opportunity. Produce an issue draft for an issue request and a pull-request draft for a pull-request request.",
      "conditions": [
        {"id": "issue", "catalog": "contribute", "input_variant": "issue"},
        {"id": "pull_request", "catalog": "contribute", "input_variant": "pull_request"}
      ]
    },
    {
      "id": "resource_vs_scalar_read",
      "prompt": "Read the supplied durable investigation reference once and summarize it. Use the resource plane when the client supports the returned resource link; otherwise use the matching scalar read tool.",
      "conditions": [
        {"id": "resource_capable", "catalog": "contribute", "client_capability": "resources"},
        {"id": "tool_only", "catalog": "contribute", "client_capability": "tools_only"}
      ]
    },
    {
      "id": "portfolio_composite_vs_manual",
      "prompt": "Refresh the authenticated contributor's open pull-request portfolio and its current health with bounded network reads, then return the durable job reference.",
      "conditions": [
        {"id": "composite", "catalog": "portfolio"},
        {"id": "manual", "catalog": "portfolio_without_composite"}
      ]
    },
    {
      "id": "deepwiki_truncation_recovery",
      "prompt": "Use DeepWiki to answer the focused architecture question. The first contents response is truncated; recover without immediately requesting a near-megabyte response.",
      "conditions": [
        {"id": "truncated", "catalog": "research", "provider_variant": "truncated_contents"},
        {"id": "focused_control", "catalog": "research", "provider_variant": "complete_focused_answer"}
      ]
    },
    {
      "id": "missing_coverage_vs_negative_evidence",
      "prompt": "Determine whether the stored corpus proves that acme/rocket has no related open implementation. Distinguish missing coverage from a complete bounded zero result.",
      "conditions": [
        {"id": "missing", "catalog": "contribute", "coverage_variant": "missing"},
        {"id": "complete_zero", "catalog": "contribute", "coverage_variant": "complete_zero"}
      ]
    },
    {
      "id": "concern_creation_through_promotion",
      "prompt": "Record the supplied source-backed concern, investigate it, and promote it only if the stored evidence satisfies the promotion boundary. Return durable identifiers.",
      "conditions": [
        {"id": "supported", "catalog": "concerns", "evidence_variant": "promotion_supported"},
        {"id": "insufficient", "catalog": "concerns", "evidence_variant": "promotion_unsupported"}
      ]
    }
  ],
  "semantic_metrics": [
    "task_success",
    "mode_correctness",
    "evidence_correctness",
    "side_effect_correctness",
    "uncertainty_correctness"
  ],
  "efficiency_metrics": [
    "invalid_calls",
    "redundant_calls",
    "result_tokens",
    "latency_ms",
    "recovery_success"
  ]
}
